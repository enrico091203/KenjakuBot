# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_id_here

# Super-owner Discord user ID (default: 591607910816284672)
# Jika tidak diisi, akan pakai default ID owner.
# OWNER_ID=591607910816284672

# User 980138308631924856 juga sudah otomatis terdaftar di whitelist.
# Tambahkan user lain via command: /banned whitelist add

# Optional: set for instant guild-specific commands (development/testing)
# GUILD_ID=your_guild_id_here

# Optional: set timezone (default is system timezone)
# TZ=Asia/Jakarta

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/kenjaku?retryWrites=true&w=majority

# xKiro AI API key
XKIRO_API_KEY=sk-xt-...
